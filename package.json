{
  "name": "atlas-carries-us-workspace",
  "private": true,
  "description": "Development workspace for Atlas Carries Us: the viewer, the TypeScript adapter and the end-to-end tests.",
  "license": "MIT",
  "workspaces": [
    "viewer",
    "adapters/typescript",
    "tests/e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write viewer adapters/typescript tests/e2e",
    "format:check": "prettier --check viewer adapters/typescript tests/e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
