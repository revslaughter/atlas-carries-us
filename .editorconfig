# One set of editor rules for every language in the repository.
# Formatters (gofmt, rustfmt, Prettier) have the final word on code.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum}]
indent_style = tab

[*.{rs,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
