{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/revslaughter/atlas-carries-us/schema/config.schema.json",
  "title": "Atlas Carries Us project config (atlas.yaml), version 1",
  "description": "Tells the acu command what to read and how to present it. docs/config.md explains every field.",
  "type": "object",
  "required": ["version", "project", "languages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "repo": { "type": "string", "description": "owner/name on the code host." },
        "links": {
          "description": "A preset name, or explicit URL templates.",
          "oneOf": [
            { "enum": ["github", "gitlab", "none"] },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "string" },
                "range": { "type": "string" },
                "folder": { "type": "string" }
              }
            }
          ]
        },
        "description": { "type": "string" },
        "descriptionDrafted": { "$ref": "#/$defs/provenance" },
        "autolinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern", "url"],
            "additionalProperties": false,
            "properties": { "pattern": { "type": "string" }, "url": { "type": "string" } }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["adapter"],
        "additionalProperties": false,
        "properties": {
          "adapter": { "type": "string", "description": "typescript, rust, go, or the name of an adapter on PATH." },
          "root": { "type": "string", "description": "Folder to read, relative to this config file. Default: the config file's folder." },
          "command": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Run this program instead of the default adapter. The first item names the program."
          },
          "include": { "type": "array", "items": { "type": "string" } },
          "exclude": { "type": "array", "items": { "type": "string" } },
          "tests": { "type": "array", "items": { "type": "string" }, "description": "Globs that mark test files." },
          "options": { "type": "object", "description": "Options that only this adapter reads." }
        }
      }
    },
    "entryPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plugin"],
        "additionalProperties": false,
        "properties": {
          "plugin": { "type": "string" },
          "options": { "type": "object" },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {
                "pathPrefix": { "type": "string" },
                "title": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "name": { "type": "string" },
          "color": { "type": "integer", "minimum": 0, "maximum": 8 },
          "paths": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Globs over unit paths (relative to the repository root). A unit goes to the first region that matches."
          },
          "default": { "type": "boolean", "description": "Units that match no region go here." },
          "description": { "type": "string" },
          "readingTip": { "type": "string" },
          "drafted": { "$ref": "#/$defs/provenance" }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "tour": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "text", "open"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "text": { "type": "string" },
          "open": { "$ref": "#/$defs/open" },
          "drafted": { "$ref": "#/$defs/provenance" }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["by", "at"],
      "additionalProperties": false,
      "properties": {
        "by": { "type": "string" },
        "at": { "type": "string" }
      }
    },
    "open": {
      "description": "The view a tour step opens. Name targets by ID, or by a name that the command resolves.",
      "type": "object",
      "required": ["view"],
      "additionalProperties": false,
      "properties": {
        "view": { "enum": ["overview", "region", "unit", "symbol", "trace"] },
        "id": { "type": "string", "description": "An exact ID (region, unit or symbol)." },
        "path": { "type": "string", "description": "A unit's path, relative to the repository root." },
        "name": { "type": "string", "description": "A symbol's qualified name, such as Immer.produce. It must match one symbol." },
        "entryPoint": { "type": "string", "description": "An entry point's ID or name, such as 'GET /posts/{id}'." },
        "symbol": { "type": "string", "description": "For a trace: the ID or qualified name of the function or method to start from." }
      }
    }
  }
}
